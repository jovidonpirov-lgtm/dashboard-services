# Required on Vercel. Use a pooled PostgreSQL URL with TLS.
DATABASE_URL=
# At least 16 characters, single administrator password.
ADMIN_PASSWORD=
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Railway bucket; server-only, Production environment.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
